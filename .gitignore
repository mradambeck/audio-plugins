*.app

# Installer build output. The leading **/ matters: a pattern with a slash in the middle, e.g.
# "installer/stage/", is anchored to the repo root and won't match inside each plugin folder --
# only a bare single-segment pattern like "build/" above is recursive by default. Each plugin's
# own installer folder is "installer/" (singular); the root group installer is "installers/"
# (plural) -- both need covering, they're different directories.
**/installer/stage/
**/installer/output/
installers/stage/
installers/output/
*.pkg
