<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Wild Jag Plugins</title>
    <organization>com.wildjag</organization>
    <domains enable_currentUserHome="true" enable_localSystem="true" enable_anywhere="false"/>
    <options customize="always" require-scripts="false"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="choice_caverns">
            <line choice="choice_caverns_au"/>
            <line choice="choice_caverns_vst3"/>
            <line choice="choice_caverns_standalone"/>
        </line>
        <line choice="choice_damage">
            <line choice="choice_damage_au"/>
            <line choice="choice_damage_vst3"/>
            <line choice="choice_damage_standalone"/>
        </line>
        <line choice="choice_corrosion">
            <line choice="choice_corrosion_au"/>
            <line choice="choice_corrosion_vst3"/>
            <line choice="choice_corrosion_standalone"/>
        </line>
        <line choice="choice_flux">
            <line choice="choice_flux_au"/>
            <line choice="choice_flux_vst3"/>
            <line choice="choice_flux_standalone"/>
        </line>
        <line choice="choice_alloy">
            <line choice="choice_alloy_au"/>
            <line choice="choice_alloy_vst3"/>
            <line choice="choice_alloy_standalone"/>
        </line>
        <line choice="choice_gradient">
            <line choice="choice_gradient_au"/>
            <line choice="choice_gradient_vst3"/>
            <line choice="choice_gradient_standalone"/>
        </line>
        <line choice="choice_shields">
            <line choice="choice_shields_au"/>
            <line choice="choice_shields_vst3"/>
            <line choice="choice_shields_standalone"/>
        </line>
        <line choice="choice_intruder">
            <line choice="choice_intruder_au"/>
            <line choice="choice_intruder_vst3"/>
            <line choice="choice_intruder_standalone"/>
        </line>
        <line choice="choice_strike">
            <line choice="choice_strike_au"/>
            <line choice="choice_strike_vst3"/>
            <line choice="choice_strike_standalone"/>
        </line>
        <line choice="choice_aura">
            <line choice="choice_aura_au"/>
            <line choice="choice_aura_vst3"/>
            <line choice="choice_aura_standalone"/>
        </line>
    </choices-outline>

    <choice id="choice_caverns" title="Caverns - Delay" description="Caverns - reverb/delay plugin."/>
    <choice id="choice_caverns_au" title="Audio Unit (AU)" description="Installs Caverns - Delay.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.caverns.au.pkg"/>
    </choice>
    <choice id="choice_caverns_vst3" title="VST3" description="Installs Caverns - Delay.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.caverns.vst3.pkg"/>
    </choice>
    <choice id="choice_caverns_standalone" title="Standalone App" description="Installs Caverns - Delay.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.caverns.standalone.pkg"/>
    </choice>

    <choice id="choice_damage" title="Damage - Fuzz" description="Damage - fuzz/distortion plugin."/>
    <choice id="choice_damage_au" title="Audio Unit (AU)" description="Installs Damage - Fuzz.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.damage.au.pkg"/>
    </choice>
    <choice id="choice_damage_vst3" title="VST3" description="Installs Damage - Fuzz.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.damage.vst3.pkg"/>
    </choice>
    <choice id="choice_damage_standalone" title="Standalone App" description="Installs Damage - Fuzz.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.damage.standalone.pkg"/>
    </choice>

    <choice id="choice_corrosion" title="Corrosion - Overdrive" description="Corrosion - lo-fi drive plugin."/>
    <choice id="choice_corrosion_au" title="Audio Unit (AU)" description="Installs Corrosion - Overdrive.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.corrosion.au.pkg"/>
    </choice>
    <choice id="choice_corrosion_vst3" title="VST3" description="Installs Corrosion - Overdrive.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.corrosion.vst3.pkg"/>
    </choice>
    <choice id="choice_corrosion_standalone" title="Standalone App" description="Installs Corrosion - Overdrive.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.corrosion.standalone.pkg"/>
    </choice>

    <choice id="choice_flux" title="Flux - Phaser" description="Flux - analog phase shifter plugin."/>
    <choice id="choice_flux_au" title="Audio Unit (AU)" description="Installs Flux - Phaser.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.flux.au.pkg"/>
    </choice>
    <choice id="choice_flux_vst3" title="VST3" description="Installs Flux - Phaser.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.flux.vst3.pkg"/>
    </choice>
    <choice id="choice_flux_standalone" title="Standalone App" description="Installs Flux - Phaser.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.flux.standalone.pkg"/>
    </choice>

    <choice id="choice_alloy" title="Alloy" description="Alloy - industrial bass synth."/>
    <choice id="choice_alloy_au" title="Audio Unit (AU)" description="Installs Alloy.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.alloy.au.pkg"/>
    </choice>
    <choice id="choice_alloy_vst3" title="VST3" description="Installs Alloy.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.alloy.vst3.pkg"/>
    </choice>
    <choice id="choice_alloy_standalone" title="Standalone App" description="Installs Alloy.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.alloy.standalone.pkg"/>
    </choice>

    <choice id="choice_gradient" title="Gradient - Pitch Delay" description="Gradient - pitch shifting delay plugin."/>
    <choice id="choice_gradient_au" title="Audio Unit (AU)" description="Installs Gradient - Pitch Delay.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.gradient.au.pkg"/>
    </choice>
    <choice id="choice_gradient_vst3" title="VST3" description="Installs Gradient - Pitch Delay.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.gradient.vst3.pkg"/>
    </choice>
    <choice id="choice_gradient_standalone" title="Standalone App" description="Installs Gradient - Pitch Delay.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.gradient.standalone.pkg"/>
    </choice>

    <choice id="choice_shields" title="Shields - Reverb" description="Shields - diffuse reverb."/>
    <choice id="choice_shields_au" title="Audio Unit (AU)" description="Installs Shields - Reverb.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.shields.au.pkg"/>
    </choice>
    <choice id="choice_shields_vst3" title="VST3" description="Installs Shields - Reverb.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.shields.vst3.pkg"/>
    </choice>
    <choice id="choice_shields_standalone" title="Standalone App" description="Installs Shields - Reverb.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.shields.standalone.pkg"/>
    </choice>

    <choice id="choice_intruder" title="Intruder - Reverb" description="Intruder - non-linear gated reverb."/>
    <choice id="choice_intruder_au" title="Audio Unit (AU)" description="Installs Intruder - Reverb.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.intruder.au.pkg"/>
    </choice>
    <choice id="choice_intruder_vst3" title="VST3" description="Installs Intruder - Reverb.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.intruder.vst3.pkg"/>
    </choice>
    <choice id="choice_intruder_standalone" title="Standalone App" description="Installs Intruder - Reverb.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.intruder.standalone.pkg"/>
    </choice>

    <choice id="choice_strike" title="Strike" description="Strike - Karplus-Strong physical-modeling string synth."/>
    <choice id="choice_strike_au" title="Audio Unit (AU)" description="Installs Strike.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.strike.au.pkg"/>
    </choice>
    <choice id="choice_strike_vst3" title="VST3" description="Installs Strike.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.strike.vst3.pkg"/>
    </choice>
    <choice id="choice_strike_standalone" title="Standalone App" description="Installs Strike.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.strike.standalone.pkg"/>
    </choice>

    <choice id="choice_aura" title="Aura - Reverb" description="Aura - AMS RMX16 Ambience reverb emulation."/>
    <choice id="choice_aura_au" title="Audio Unit (AU)" description="Installs Aura - Reverb.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.aura.au.pkg"/>
    </choice>
    <choice id="choice_aura_vst3" title="VST3" description="Installs Aura - Reverb.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.aura.vst3.pkg"/>
    </choice>
    <choice id="choice_aura_standalone" title="Standalone App" description="Installs Aura - Reverb.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.aura.standalone.pkg"/>
    </choice>

    <pkg-ref id="com.wildjag.caverns.au.pkg" version="__CAVERNS_VERSION__" onConclusion="none">Caverns-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.caverns.vst3.pkg" version="__CAVERNS_VERSION__" onConclusion="none">Caverns-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.caverns.standalone.pkg" version="__CAVERNS_VERSION__" onConclusion="none">Caverns-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.damage.au.pkg" version="__DAMAGE_VERSION__" onConclusion="none">Damage-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.damage.vst3.pkg" version="__DAMAGE_VERSION__" onConclusion="none">Damage-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.damage.standalone.pkg" version="__DAMAGE_VERSION__" onConclusion="none">Damage-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.corrosion.au.pkg" version="__CORROSION_VERSION__" onConclusion="none">Corrosion-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.corrosion.vst3.pkg" version="__CORROSION_VERSION__" onConclusion="none">Corrosion-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.corrosion.standalone.pkg" version="__CORROSION_VERSION__" onConclusion="none">Corrosion-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.flux.au.pkg" version="__FLUX_VERSION__" onConclusion="none">Flux-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.flux.vst3.pkg" version="__FLUX_VERSION__" onConclusion="none">Flux-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.flux.standalone.pkg" version="__FLUX_VERSION__" onConclusion="none">Flux-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.alloy.au.pkg" version="__ALLOY_VERSION__" onConclusion="none">Alloy-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.alloy.vst3.pkg" version="__ALLOY_VERSION__" onConclusion="none">Alloy-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.alloy.standalone.pkg" version="__ALLOY_VERSION__" onConclusion="none">Alloy-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.gradient.au.pkg" version="__GRADIENT_VERSION__" onConclusion="none">Gradient-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.gradient.vst3.pkg" version="__GRADIENT_VERSION__" onConclusion="none">Gradient-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.gradient.standalone.pkg" version="__GRADIENT_VERSION__" onConclusion="none">Gradient-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.shields.au.pkg" version="__SHIELDS_VERSION__" onConclusion="none">Shields-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.shields.vst3.pkg" version="__SHIELDS_VERSION__" onConclusion="none">Shields-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.shields.standalone.pkg" version="__SHIELDS_VERSION__" onConclusion="none">Shields-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.intruder.au.pkg" version="__INTRUDER_VERSION__" onConclusion="none">Intruder-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.intruder.vst3.pkg" version="__INTRUDER_VERSION__" onConclusion="none">Intruder-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.intruder.standalone.pkg" version="__INTRUDER_VERSION__" onConclusion="none">Intruder-Standalone-Component.pkg</pkg-ref>

    <pkg-ref id="com.wildjag.strike.au.pkg" version="__STRIKE_VERSION__" onConclusion="none">Strike-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.strike.vst3.pkg" version="__STRIKE_VERSION__" onConclusion="none">Strike-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.strike.standalone.pkg" version="__STRIKE_VERSION__" onConclusion="none">Strike-Standalone-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.aura.au.pkg" version="__AURA_VERSION__" onConclusion="none">Aura-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.aura.vst3.pkg" version="__AURA_VERSION__" onConclusion="none">Aura-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.aura.standalone.pkg" version="__AURA_VERSION__" onConclusion="none">Aura-Standalone-Component.pkg</pkg-ref>
</installer-gui-script>
