<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Flux</title>
    <organization>com.wildjag</organization>
    <domains enable_currentUserHome="true" enable_localSystem="true" enable_anywhere="false"/>
    <options customize="always" require-scripts="false"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="choice_au"/>
        <line choice="choice_vst3"/>
        <line choice="choice_standalone"/>
    </choices-outline>

    <choice id="choice_au" title="Audio Unit (AU)" description="Installs Flux.component into Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.wildjag.flux.au.pkg"/>
    </choice>
    <choice id="choice_vst3" title="VST3" description="Installs Flux.vst3 into Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.wildjag.flux.vst3.pkg"/>
    </choice>
    <choice id="choice_standalone" title="Standalone App" description="Installs Flux.app into Applications." start_selected="true">
        <pkg-ref id="com.wildjag.flux.standalone.pkg"/>
    </choice>

    <pkg-ref id="com.wildjag.flux.au.pkg" version="0.1.0" onConclusion="none">Flux-AU-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.flux.vst3.pkg" version="0.1.0" onConclusion="none">Flux-VST3-Component.pkg</pkg-ref>
    <pkg-ref id="com.wildjag.flux.standalone.pkg" version="0.1.0" onConclusion="none">Flux-Standalone-Component.pkg</pkg-ref>
</installer-gui-script>
